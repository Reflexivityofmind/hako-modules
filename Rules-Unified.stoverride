rules:
  # VPS 自身流量直连（防代理回环）
  - IP-CIDR,207.148.88.18/32,DIRECT,no-resolve
  - IP-CIDR6,2001:19f0:7001:397c:5400:5ff:fee3:8fd3/128,DIRECT,no-resolve
  - DOMAIN-SUFFIX,takecareoflanguage.org,DIRECT
  - DOMAIN-SUFFIX,sjuku.top,DIRECT
  - DOMAIN-SUFFIX,cupl.edu.cn,DIRECT
  # Siri / Apple Intelligence
  - DOMAIN-SUFFIX,siri.apple.com,🚀 节点选择
  - DOMAIN,api-siri-prod.apple.com,🚀 节点选择
  - DOMAIN,guzzoni.apple.com,🚀 节点选择
  - DOMAIN-SUFFIX,smoot.apple.com,🚀 节点选择
  - DOMAIN,apple-relay.cloudflare.com,🚀 节点选择
  - DOMAIN,apple-relay.fastly-edge.com,🚀 节点选择
  - DOMAIN,cp4.cloudflare.com,🚀 节点选择
  - DOMAIN,apple-relay.apple.com,🚀 节点选择
  # Apple 推送与 iCloud 隐私代理
  - DOMAIN-SUFFIX,push.apple.com,🚀 节点选择
  - DOMAIN,mask-api.icloud.com,🚀 节点选择
  - DOMAIN,mask-h2.icloud.com,🚀 节点选择
  - DOMAIN,mask.icloud.com,🚀 节点选择
  - DOMAIN,cdn.bsky.app,🚀 节点选择
  - DOMAIN-SUFFIX,manhuagui.com,🚀 节点选择
  - RULE-SET,advertising,REJECT
  - RULE-SET,openai,🚀 节点选择
  - RULE-SET,claude,🚀 节点选择
