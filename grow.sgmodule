[Script]
Grow = type=http-response, pattern=^https?:\/\/api\.revenuecat\.com\/v\d\/subscribers\/(\$RCAnonymousID\%)?(\w)+$, script-path=https://raw.githubusercontent.com/I-am-R-E/QuantumultX/main/JavaScript/Grow.js, requires-body=true

Grow = type=http-response, pattern=^https?:\/\/api\.revenuecat\.com\/v\d\/receipts$, script-path=https://raw.githubusercontent.com/I-am-R-E/QuantumultX/main/JavaScript/Grow.js, requires-body=true

[MITM]
hostname = %APPEND% api.revenuecat.com

