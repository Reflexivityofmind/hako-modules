name: DNS
desc: 全 DoH 加密 DNS（零明文）：国内 AliDNS+DNSPod，国外 Cloudflare+Google；nameserver 全部 IP 化 DoH，无域名需引导解析
icon: "https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Global.png"
category: "General"

dns:
  enable: true
  ipv6: true
  listen: 0.0.0.0:53
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16
  fake-ip-filter:
    - '*.lan'
    - localhost.ptlogin2.qq.com
    - '+.srv.nintendo.net'
    - '+.stun.playstation.net'
    - '+.msftconnecttest.com'
    - '+.msftncsi.com'
    - '+.xboxlive.com'
    - 'msftconnecttest.com'
    - 'xbox.*.microsoft.com'
    - '*.battlenet.com.cn'
    - '*.battlenet.com'
    - '*.blzstatic.cn'
    - '*.battle.net'
  # 仅用于解析 DNS 服务器自身域名；nameserver 已全部 IP 化，正常不会被使用
  default-nameserver:
    - 223.5.5.5
    - 119.29.29.29
  # 将完全覆盖原有 nameserver（清除明文 119.29.29.29 / 223.5.5.5）
  nameserver: #!replace
    - https://223.5.5.5/dns-query
    - https://120.53.53.53/dns-query
  # 将完全覆盖原有 fallback
  fallback: #!replace
    - https://1.1.1.1/dns-query
    - https://8.8.8.8/dns-query
  proxy-server-nameserver: #!replace
    - https://223.5.5.5/dns-query
  direct-nameserver: #!replace
    - https://223.5.5.5/dns-query
    - https://120.53.53.53/dns-query
  fallback-filter:
    geoip: true
    geoip-code: CN
    ipcidr:
      - 240.0.0.0/4
