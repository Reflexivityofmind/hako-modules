#!name=解除微信链接限制
#!desc=解除链接限制
#!category=Egern 30 Unlock Check-in
#!author=@zZPiglet
#!icon=https://raw.githubusercontent.com/deezertidal/private/main/icons/wechatad.png
#!homepage=https://github.com/zZPiglet/Task/tree/master

[Script]
UnblockURLinWeChat = type=http-response, pattern=^https\:\/\/(weixin110\.qq|security.wechat)\.com\/cgi-bin\/mmspamsupport-bin\/newredirectconfirmcgi\?, script-path=https://raw.githubusercontent.com/zZPiglet/Task/master/asset/UnblockURLinWeChat.js, requires-body=true, timeout=10

[MITM]
hostname = %APPEND% weixin110.qq.com, security.wechat.com

